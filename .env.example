# Database Configuration
DATABASE_URL="postgresql://telemedicine_user:password123@localhost:5432/telemedicine_db"
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OTP & SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Alternative SMS (MSG91 for India)
MSG91_API_KEY="your-msg91-api-key"
MSG91_SENDER_ID="TELMED"

# Email Configuration (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
FROM_EMAIL="noreply@telemedicine.com"
FROM_NAME="Telemedicine Platform"

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Alternative Storage (AWS S3)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="telemedicine-files"

# Payment Configuration (Razorpay for India)
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Payment Configuration (Stripe for Global)
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# Video & TURN Server Configuration
COTURN_USERNAME="turnuser"
COTURN_PASSWORD="turnpassword123"
TURN_SERVER_URL="turn:your-turn-server.com:3478"
STUN_SERVER_URL="stun:stun.l.google.com:19302"

# Jitsi Configuration (Fallback)
JITSI_APP_ID="your-jitsi-app-id"
JITSI_API_KEY="your-jitsi-api-key"

# Monitoring & Error Tracking
SENTRY_DSN="your-sentry-dsn"
SENTRY_ENVIRONMENT="development"

# Logging
LOG_LEVEL="debug"
LOG_FORMAT="json"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Security
BCRYPT_ROUNDS="12"
CORS_ORIGIN="http://localhost:3000"
CSRF_SECRET="your-csrf-secret"

# Application URLs
API_BASE_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Frontend Environment Variables (NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-public-razorpay-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"
NEXT_PUBLIC_SENTRY_DSN="your-frontend-sentry-dsn"

# Development Tools
PRISMA_STUDIO_PORT="5555"
MAILHOG_WEB_PORT="8025"
MAILHOG_SMTP_PORT="1025"

# Docker Configuration
POSTGRES_USER="telemedicine_user"
POSTGRES_PASSWORD="password123"
POSTGRES_DB="telemedicine_db"
POSTGRES_PORT="5432"

# Backup Configuration
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS="30"
BACKUP_S3_BUCKET="telemedicine-backups"

# Feature Flags
ENABLE_VIDEO_RECORDING="false"
ENABLE_AI_DIAGNOSIS="false"
ENABLE_MULTI_LANGUAGE="true"
ENABLE_PHARMACY_INTEGRATION="true"

# Compliance & Audit
AUDIT_LOG_RETENTION_DAYS="2555"
ENCRYPTION_KEY="your-32-character-encryption-key"
DATA_RETENTION_DAYS="2555"

# Third-party Integrations
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
FIREBASE_PROJECT_ID="your-firebase-project"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# Notification Configuration
PUSH_NOTIFICATION_VAPID_PUBLIC="your-vapid-public-key"
PUSH_NOTIFICATION_VAPID_PRIVATE="your-vapid-private-key"

# Analytics
GOOGLE_ANALYTICS_ID="your-ga-tracking-id"
MIXPANEL_TOKEN="your-mixpanel-token"
